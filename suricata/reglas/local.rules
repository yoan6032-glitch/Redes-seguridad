#reglas genericas
alert icmp any any -> any any  (msg: "ping icmp detectado"; sid:2000001; rev:1;)
alert tcp any any -> any 22 (msg:"conexion ssh detectada"; flow:to_server, established; app-layer-protocol:ssh; sid:2273009; rev:2; threshold:type limit, track by_src, count 1, seconds 60;)
alert tcp $HOME_NET any -> any !80 (app-layer-protocol: http; msg: "http sospechoso por puerto distinto al 80";flow:to_server,established; sid:2000002; rev:1;)
alert smb any any -> $HOME_NET 445 (msg:"conexion SMB detectada"; sid:2000007; rev:1;)
alert tcp any any -> $HOME_NET 445 (msg:"SMB acceso sospechoso desde red externa"; flow:to_server, established; content:"|FF|SMB"; depth:4; sid:2000003; rev:1;)
alert udp $HOME_NET-1 any -> any 53  (msg:"consulta DNS no autorisada a dominio interno"; content:"DIC.ohc"; sid:2000004; rev:1;)
alert tls any any -> $HOME_NET any (msg:"TLS sertificado autofirmado sospechoso"; tls.subject:"CN=SelfSigned"; sid:2000005; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"HTTP POST detectado"; flow:to_server,established; http.method;content:"POST"; sid:2000006; rev:1;)

##nmap
alert tcp any any -> any !22 (msg:"namap fin scan"; flags:F; sid:1000008; rev:1; )
alert tcp any any -> any !22 (msg:"nmap null scan"; flags:0; sid:1000009; rev:1;)
alert udp $EXTERNAL_NET any -> $HOME_NET any (msg:"nmap udp scan"; sid:10000010; rev:1; threshold:type threshold, track by_src, count 10,seconds 5; )
alert tcp any any -> any !22  (msg:"nmap jonas tree sacn"; flags:FRU; sid:1000006; rev:1;)
alert tcp any any -> any !22 (msg:"nmap tcp scan"; flags:S; flow:to_server; sid:1000005; rev:3; threshold:type threshold, track by_src, count 20,seconds 5;)
alert icmp any any -> any any (msg:"nmap ping sweep scan"; dsize:0; sid:1000004; rev:1;)

